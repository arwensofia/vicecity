--- a/pcsx2/GS/Renderers/Metal/GSMTLDeviceInfo.mm
+++ b/pcsx2/GS/Renderers/Metal/GSMTLDeviceInfo.mm
@@ -33,6 +33,23 @@
 			return MRCTransfer(lib);
 	if (id<MTLLibrary> lib = loadMainLibrary(dev, @"default"))
 		return MRCTransfer(lib);
+#ifdef VC_METAL_RUNTIME_SHADERS
+	// vicecity: no offline Metal compiler in the Command Line Tools; compile the amalgamated
+	// shader source (generated by third_party/scripts/amalgamate_metal.py) at runtime.
+	if (@available(macOS 11.0, iOS 14.0, *))
+	{
+		static const char source[] =
+#include "pcsx2_metal_shaders.inc"
+		;
+		MRCOwned<MTLCompileOptions*> opts = MRCTransfer([MTLCompileOptions new]);
+		[opts setLanguageVersion:MTLLanguageVersion2_3];
+		NSError* err = nil;
+		NSString* src = [[[NSString alloc] initWithBytes:source length:sizeof(source) - 1 encoding:NSUTF8StringEncoding] autorelease];
+		if (id<MTLLibrary> lib = [dev newLibraryWithSource:src options:opts error:&err])
+			return MRCTransfer(lib);
+		Console.Error("Metal: failed to compile shader library: %s", err ? [[err localizedDescription] UTF8String] : "unknown error");
+	}
+#endif
 	return MRCTransfer([dev newDefaultLibrary]);
 }
 
